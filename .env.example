# 키움 모의투자 인증정보. 실제 값은 서버의 /etc/stock-website.env에만 설정한다.
MOCK_DOMESTIC_APP_KEY=
MOCK_DOMESTIC_APP_SECRET=
MOCK_OVERSEAS_APP_KEY=
MOCK_OVERSEAS_APP_SECRET=

# 키움 실투자 인증정보. 실투자 환경에서는 조회 API만 사용하며 주문은 서버에서 차단한다.
LIVE_DOMESTIC_APP_KEY=
LIVE_DOMESTIC_APP_SECRET=
LIVE_OVERSEAS_APP_KEY=
LIVE_OVERSEAS_APP_SECRET=

# 사이트 접속 비밀번호. 클라이언트 코드에 넣지 않고 서버 환경에만 설정한다.
PASSWORD=

# 운영용 Node 서버. systemd 템플릿에도 같은 기본값이 설정되어 있다.
HOST=127.0.0.1
PORT=3000
